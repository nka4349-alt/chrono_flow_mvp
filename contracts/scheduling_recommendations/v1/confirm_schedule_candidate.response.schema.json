{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chronoflow.app/contracts/scheduling_recommendations/v1/confirm_schedule_candidate.response.schema.json",
  "title": "Confirm schedule candidate response",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "schema_version",
        "operation",
        "status",
        "request_id",
        "trace_id",
        "recommendation_id",
        "candidate_id",
        "schedule_snapshot_version",
        "event_id",
        "feedback_event_id",
        "final_slot",
        "committed_at"
      ],
      "properties": {
        "schema_version": { "$ref": "common.schema.json#/$defs/schemaVersion" },
        "operation": { "type": "string", "const": "confirm_schedule_candidate" },
        "status": { "type": "string", "const": "committed" },
        "request_id": { "$ref": "common.schema.json#/$defs/requestId" },
        "trace_id": { "$ref": "common.schema.json#/$defs/traceId" },
        "recommendation_id": { "$ref": "common.schema.json#/$defs/recommendationId" },
        "candidate_id": { "$ref": "common.schema.json#/$defs/candidateId" },
        "revision_id": { "$ref": "common.schema.json#/$defs/revisionId" },
        "schedule_snapshot_version": { "$ref": "common.schema.json#/$defs/scheduleSnapshotVersion" },
        "event_id": { "$ref": "common.schema.json#/$defs/eventId" },
        "feedback_event_id": { "$ref": "common.schema.json#/$defs/feedbackEventId" },
        "final_slot": { "$ref": "common.schema.json#/$defs/timeSlot" },
        "committed_at": { "$ref": "common.schema.json#/$defs/dateTime" }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "schema_version",
        "operation",
        "status",
        "request_id",
        "trace_id",
        "error"
      ],
      "properties": {
        "schema_version": { "$ref": "common.schema.json#/$defs/schemaVersion" },
        "operation": { "type": "string", "const": "confirm_schedule_candidate" },
        "status": { "type": "string", "const": "error" },
        "request_id": { "$ref": "common.schema.json#/$defs/requestId" },
        "trace_id": { "$ref": "common.schema.json#/$defs/traceId" },
        "error": { "$ref": "error.schema.json" }
      },
      "additionalProperties": false
    }
  ]
