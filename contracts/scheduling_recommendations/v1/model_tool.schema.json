{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chronoflow.app/contracts/scheduling_recommendations/v1/model_tool.schema.json",
  "title": "Scheduling recommendation model-visible Tool contract",
  "$defs": {
    "modelCandidate": {
      "type": "object",
      "required": [
        "candidate_id",
        "rank",
        "slot",
        "reason_codes",
        "penalty_codes",
        "score"
      ],
      "properties": {
        "candidate_id": { "$ref": "common.schema.json#/$defs/candidateId" },
        "rank": { "type": "integer", "minimum": 1 },
        "slot": { "$ref": "common.schema.json#/$defs/timeSlot" },
        "reason_codes": { "$ref": "common.schema.json#/$defs/reasonCodes" },
        "penalty_codes": { "$ref": "common.schema.json#/$defs/penaltyCodes" },
        "score": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "modelRevisedCandidate": {
      "type": "object",
      "required": [
        "recommendation_id",
        "candidate_id",
        "revision_id",
        "rank",
        "feasible",
        "slot",
        "reason_codes",
        "penalty_codes",
        "score"
      ],
      "properties": {
        "recommendation_id": { "$ref": "common.schema.json#/$defs/recommendationId" },
        "candidate_id": { "$ref": "common.schema.json#/$defs/candidateId" },
        "revision_id": { "$ref": "common.schema.json#/$defs/revisionId" },
        "rank": { "type": "integer", "minimum": 1 },
        "feasible": { "type": "boolean", "const": true },
        "slot": { "$ref": "common.schema.json#/$defs/timeSlot" },
        "reason_codes": { "$ref": "common.schema.json#/$defs/reasonCodes" },
        "penalty_codes": { "$ref": "common.schema.json#/$defs/penaltyCodes" },
        "score": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "recommendTimeSlotsArguments": {
      "type": "object",
      "required": ["title", "duration_minutes", "search_window"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "duration_minutes": { "$ref": "common.schema.json#/$defs/durationMinutes" },
        "search_window": { "$ref": "common.schema.json#/$defs/searchWindow" }
      },
      "additionalProperties": false
    },
    "reviseTimeSlotArguments": {
      "type": "object",
      "required": ["recommendation_id", "candidate_id", "proposed_slot"],
      "properties": {
        "recommendation_id": { "$ref": "common.schema.json#/$defs/recommendationId" },
        "candidate_id": { "$ref": "common.schema.json#/$defs/candidateId" },
        "proposed_slot": { "$ref": "common.schema.json#/$defs/timeSlot" },
        "optional_change_reason": {
          "type": "string",
          "enum": [
            "PREFERRED_EARLIER_TIME",
            "PREFERRED_LATER_TIME",
            "AVOID_BACK_TO_BACK",
            "REDUCE_TRAVEL",
            "OTHER"
          ]
        }
      },
      "additionalProperties": false
    },
    "confirmScheduleCandidateArguments": {
      "type": "object",
      "required": ["recommendation_id", "candidate_id"],
      "properties": {
        "recommendation_id": { "$ref": "common.schema.json#/$defs/recommendationId" },
        "candidate_id": { "$ref": "common.schema.json#/$defs/candidateId" },
        "revision_id": { "$ref": "common.schema.json#/$defs/revisionId" }
      },
      "additionalProperties": false
    },
    "rejectScheduleRecommendationArguments": {
      "type": "object",
      "required": ["recommendation_id", "action"],
      "properties": {
        "recommendation_id": { "$ref": "common.schema.json#/$defs/recommendationId" },
        "action": {
          "type": "string",
          "enum": ["rejected_all", "dismissed"]
        },
        "optional_reason": {
          "type": "string",
          "enum": [
            "NO_SUITABLE_TIME",
            "TOO_EARLY",
            "TOO_LATE",
            "TOO_MUCH_TRAVEL",
            "SCHEDULE_TOO_FULL",
            "OTHER"
          ]
        }
      },
      "additionalProperties": false
    },
    "errorNoFeasibleSlot": {
      "type": "object",
      "required": ["status", "code", "message_code", "retryable"],
      "properties": {
        "status": { "type": "string", "const": "error" },
        "code": { "type": "string", "const": "NO_FEASIBLE_SLOT" },
        "message_code": { "type": "string", "const": "NO_FEASIBLE_SLOT_AVAILABLE" },
        "retryable": { "type": "boolean", "const": false }
      },
      "additionalProperties": false
    },
    "errorLocationRequired": {
      "type": "object",
      "required": ["status", "code", "message_code", "retryable"],
      "properties": {
        "status": { "type": "string", "const": "error" },
        "code": { "type": "string", "const": "LOCATION_REQUIRED" },
        "message_code": { "type": "string", "const": "LOCATION_REQUIRED" },
        "retryable": { "type": "boolean", "const": false }
      },
      "additionalProperties": false
    },
    "errorTravelTimeUnavailable": {
      "type": "object",
      "required": ["status", "code", "message_code", "retryable"],
      "properties": {
        "status": { "type": "string", "const": "error" },
        "code": { "type": "string", "const": "TRAVEL_TIME_UNAVAILABLE" },
        "message_code": { "type": "string", "const": "TRAVEL_TIME_UNAVAILABLE" },
        "retryable": { "type": "boolean", "const": true }
      },
      "additionalProperties": false
    },
    "errorOpeningHoursUnavailable": {
      "type": "object",
      "required": ["status", "code", "message_code", "retryable"],
      "properties": {
        "status": { "type": "string", "const": "error" },
        "code": { "type": "string", "const": "OPENING_HOURS_UNAVAILABLE" },
        "message_code": { "type": "string", "const": "OPENING_HOURS_UNAVAILABLE" },
        "retryable": { "type": "boolean", "const": true }
      },
      "additionalProperties": false
    },
    "errorProfileNotConfigured": {
      "type": "object",
      "required": ["status", "code", "message_code", "retryable"],
      "properties": {
        "status": { "type": "string", "const": "error" },
        "code": { "type": "string", "const": "PROFILE_NOT_CONFIGURED" },
        "message_code": { "type": "string", "const": "PROFILE_NOT_CONFIGURED" },
        "retryable": { "type": "boolean", "const": false }
      },
      "additionalProperties": false
    },
    "errorInvalidTimeWindow": {
      "type": "object",
      "required": ["status", "code", "message_code", "retryable"],
      "properties": {
        "status": { "type": "string", "const": "error" },
        "code": { "type": "string", "const": "INVALID_TIME_WINDOW" },
        "message_code": { "type": "string", "const": "TIME_WINDOW_INVALID" },
        "retryable": { "type": "boolean", "const": false }
      },
      "additionalProperties": false
    },
    "errorInvalidDuration": {
      "type": "object",
      "required": ["status", "code", "message_code", "retryable"],
      "properties": {
        "status": { "type": "string", "const": "error" },
        "code": { "type": "string", "const": "INVALID_DURATION" },
        "message_code": { "type": "string", "const": "DURATION_INVALID" },
        "retryable": { "type": "boolean", "const": false }
      },
      "additionalProperties": false
    },
    "errorRecommendationNotFound": {
      "type": "object",
      "required": ["status", "code", "message_code", "retryable"],
      "properties": {
        "status": { "type": "string", "const": "error" },
        "code": { "type": "string", "const": "RECOMMENDATION_NOT_FOUND" },
        "message_code": { "type": "string", "const": "RECOMMENDATION_NOT_FOUND" },
        "retryable": { "type": "boolean", "const": false }
      },
      "additionalProperties": false
    },
    "errorCandidateNotFound": {
      "type": "object",
      "required": ["status", "code", "message_code", "retryable"],
      "properties": {
        "status": { "type": "string", "const": "error" },
        "code": { "type": "string", "const": "CANDIDATE_NOT_FOUND" },
        "message_code": { "type": "string", "const": "CANDIDATE_NOT_FOUND" },
        "retryable": { "type": "boolean", "const": false }
      },
      "additionalProperties": false
    },
    "errorRevisionNotFound": {
      "type": "object",
      "required": ["status", "code", "message_code", "retryable"],
      "properties": {
        "status": { "type": "string", "const": "error" },
        "code": { "type": "string", "const": "REVISION_NOT_FOUND" },
        "message_code": { "type": "string", "const": "REVISION_NOT_FOUND" },
        "retryable": { "type": "boolean", "const": false }
      },
      "additionalProperties": false
    },
    "errorRecommendationExpired": {
      "type": "object",
      "required": ["status", "code", "message_code", "retryable"],
      "properties": {
        "status": { "type": "string", "const": "error" },
        "code": { "type": "string", "const": "RECOMMENDATION_EXPIRED" },
        "message_code": { "type": "string", "const": "RECOMMENDATION_EXPIRED" },
        "retryable": { "type": "boolean", "const": false }
      },
      "additionalProperties": false
    },
    "errorStaleScheduleSnapshot": {
      "type": "object",
      "required": ["status", "code", "message_code", "retryable"],
      "properties": {
        "status": { "type": "string", "const": "error" },
        "code": { "type": "string", "const": "STALE_SCHEDULE_SNAPSHOT" },
        "message_code": { "type": "string", "const": "SCHEDULE_CHANGED_RETRY_REQUIRED" },
        "retryable": { "type": "boolean", "const": false }
      },
      "additionalProperties": false
    },
    "errorCandidateNotFeasible": {
      "type": "object",
      "required": ["status", "code", "message_code", "retryable"],
      "properties": {
        "status": { "type": "string", "const": "error" },
        "code": { "type": "string", "const": "CANDIDATE_NOT_FEASIBLE" },
        "message_code": { "type": "string", "const": "CANDIDATE_NOT_FEASIBLE" },
        "retryable": { "type": "boolean", "const": false }
      },
      "additionalProperties": false
    },
    "errorConflictDetected": {
      "type": "object",
      "required": ["status", "code", "message_code", "retryable"],
      "properties": {
        "status": { "type": "string", "const": "error" },
        "code": { "type": "string", "const": "CONFLICT_DETECTED" },
        "message_code": { "type": "string", "const": "SLOT_NO_LONGER_AVAILABLE" },
        "retryable": { "type": "boolean", "const": false }
      },
      "additionalProperties": false
    },
    "errorConfirmationRequired": {
      "type": "object",
      "required": ["status", "code", "message_code", "retryable"],
      "properties": {
        "status": { "type": "string", "const": "error" },
        "code": { "type": "string", "const": "CONFIRMATION_REQUIRED" },
        "message_code": { "type": "string", "const": "CONFIRMATION_REQUIRED" },
        "retryable": { "type": "boolean", "const": false }
      },
      "additionalProperties": false
    },
    "errorInvalidConfirmationToken": {
      "type": "object",
      "required": ["status", "code", "message_code", "retryable"],
      "properties": {
        "status": { "type": "string", "const": "error" },
        "code": { "type": "string", "const": "INVALID_CONFIRMATION_TOKEN" },
        "message_code": { "type": "string", "const": "CONFIRMATION_TOKEN_INVALID" },
        "retryable": { "type": "boolean", "const": false }
      },
      "additionalProperties": false
    },
    "errorIdempotencyConflict": {
      "type": "object",
      "required": ["status", "code", "message_code", "retryable"],
      "properties": {
        "status": { "type": "string", "const": "error" },
        "code": { "type": "string", "const": "IDEMPOTENCY_CONFLICT" },
        "message_code": { "type": "string", "const": "IDEMPOTENCY_KEY_CONFLICT" },
        "retryable": { "type": "boolean", "const": false }
      },
      "additionalProperties": false
    },
    "errorSpecialistTimeout": {
      "type": "object",
      "required": ["status", "code", "message_code", "retryable"],
      "properties": {
        "status": { "type": "string", "const": "error" },
        "code": { "type": "string", "const": "SPECIALIST_TIMEOUT" },
        "message_code": { "type": "string", "const": "SPECIALIST_TIMEOUT" },
        "retryable": { "type": "boolean", "const": true }
      },
      "additionalProperties": false
    },
    "errorContractInvalid": {
      "type": "object",
      "required": ["status", "code", "message_code", "retryable"],
      "properties": {
        "status": { "type": "string", "const": "error" },
        "code": { "type": "string", "const": "CONTRACT_INVALID" },
        "message_code": { "type": "string", "const": "REQUEST_CONTRACT_INVALID" },
        "retryable": { "type": "boolean", "const": false }
      },
      "additionalProperties": false
    },
    "errorOperationNotAllowed": {
      "type": "object",
      "required": ["status", "code", "message_code", "retryable"],
      "properties": {
        "status": { "type": "string", "const": "error" },
        "code": { "type": "string", "const": "OPERATION_NOT_ALLOWED" },
        "message_code": { "type": "string", "const": "OPERATION_NOT_ALLOWED" },
        "retryable": { "type": "boolean", "const": false }
      },
      "additionalProperties": false
    },
    "recommendTimeSlotsSuccessResult": {
      "type": "object",
      "required": ["status", "recommendation_id", "expires_at", "candidates"],
      "properties": {
        "status": { "type": "string", "const": "success" },
        "recommendation_id": { "$ref": "common.schema.json#/$defs/recommendationId" },
        "expires_at": { "$ref": "common.schema.json#/$defs/dateTime" },
        "candidates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": { "$ref": "#/$defs/modelCandidate" }
        }
      },
      "additionalProperties": false
    },
    "recommendTimeSlotsErrorResult": {
      "oneOf": [
        { "$ref": "#/$defs/errorNoFeasibleSlot" },
        { "$ref": "#/$defs/errorLocationRequired" },
        { "$ref": "#/$defs/errorTravelTimeUnavailable" },
        { "$ref": "#/$defs/errorOpeningHoursUnavailable" },
        { "$ref": "#/$defs/errorProfileNotConfigured" },
        { "$ref": "#/$defs/errorInvalidTimeWindow" },
        { "$ref": "#/$defs/errorInvalidDuration" },
        { "$ref": "#/$defs/errorSpecialistTimeout" },
        { "$ref": "#/$defs/errorContractInvalid" },
        { "$ref": "#/$defs/errorOperationNotAllowed" }
      ]
    },
    "recommendTimeSlotsResult": {
      "oneOf": [
        { "$ref": "#/$defs/recommendTimeSlotsSuccessResult" },
        { "$ref": "#/$defs/recommendTimeSlotsErrorResult" }
      ]
    },
    "reviseTimeSlotSuccessResult": {
      "type": "object",
      "required": [
        "status",
        "recommendation_id",
        "candidate_id",
        "revision_id",
        "expires_at",
        "revised_candidate",
        "requires_confirmation"
      ],
      "properties": {
        "status": { "type": "string", "const": "success" },
        "recommendation_id": { "$ref": "common.schema.json#/$defs/recommendationId" },
        "candidate_id": { "$ref": "common.schema.json#/$defs/candidateId" },
        "revision_id": { "$ref": "common.schema.json#/$defs/revisionId" },
        "expires_at": { "$ref": "common.schema.json#/$defs/dateTime" },
        "revised_candidate": { "$ref": "#/$defs/modelRevisedCandidate" },
        "requires_confirmation": { "type": "boolean", "const": true }
      },
      "additionalProperties": false
    },
    "reviseTimeSlotErrorResult": {
      "oneOf": [
        { "$ref": "#/$defs/errorRecommendationNotFound" },
        { "$ref": "#/$defs/errorCandidateNotFound" },
        { "$ref": "#/$defs/errorRecommendationExpired" },
        { "$ref": "#/$defs/errorStaleScheduleSnapshot" },
        { "$ref": "#/$defs/errorCandidateNotFeasible" },
        { "$ref": "#/$defs/errorConflictDetected" },
        { "$ref": "#/$defs/errorLocationRequired" },
        { "$ref": "#/$defs/errorTravelTimeUnavailable" },
        { "$ref": "#/$defs/errorOpeningHoursUnavailable" },
        { "$ref": "#/$defs/errorProfileNotConfigured" },
        { "$ref": "#/$defs/errorInvalidTimeWindow" },
        { "$ref": "#/$defs/errorInvalidDuration" },
        { "$ref": "#/$defs/errorSpecialistTimeout" },
        { "$ref": "#/$defs/errorContractInvalid" },
        { "$ref": "#/$defs/errorOperationNotAllowed" }
      ]
    },
    "reviseTimeSlotResult": {
      "oneOf": [
        { "$ref": "#/$defs/reviseTimeSlotSuccessResult" },
        { "$ref": "#/$defs/reviseTimeSlotErrorResult" }
      ]
    },
    "confirmScheduleCandidateSuccessResult": {
      "type": "object",
      "required": [
        "status",
        "recommendation_id",
        "candidate_id",
        "final_slot"
      ],
      "properties": {
        "status": { "type": "string", "const": "committed" },
        "recommendation_id": { "$ref": "common.schema.json#/$defs/recommendationId" },
        "candidate_id": { "$ref": "common.schema.json#/$defs/candidateId" },
        "revision_id": { "$ref": "common.schema.json#/$defs/revisionId" },
        "final_slot": { "$ref": "common.schema.json#/$defs/timeSlot" }
      },
      "additionalProperties": false
    },
    "confirmScheduleCandidateErrorResult": {
      "oneOf": [
        { "$ref": "#/$defs/errorRecommendationNotFound" },
        { "$ref": "#/$defs/errorCandidateNotFound" },
        { "$ref": "#/$defs/errorRevisionNotFound" },
        { "$ref": "#/$defs/errorRecommendationExpired" },
        { "$ref": "#/$defs/errorStaleScheduleSnapshot" },
        { "$ref": "#/$defs/errorCandidateNotFeasible" },
        { "$ref": "#/$defs/errorConflictDetected" },
        { "$ref": "#/$defs/errorConfirmationRequired" },
        { "$ref": "#/$defs/errorInvalidConfirmationToken" },
        { "$ref": "#/$defs/errorIdempotencyConflict" },
        { "$ref": "#/$defs/errorSpecialistTimeout" },
        { "$ref": "#/$defs/errorContractInvalid" },
        { "$ref": "#/$defs/errorOperationNotAllowed" }
      ]
    },
    "confirmScheduleCandidateResult": {
      "oneOf": [
        { "$ref": "#/$defs/confirmScheduleCandidateSuccessResult" },
        { "$ref": "#/$defs/confirmScheduleCandidateErrorResult" }
      ]
    },
    "rejectScheduleRecommendationSuccessResult": {
      "type": "object",
      "required": ["status", "recommendation_id", "action"],
      "properties": {
        "status": { "type": "string", "const": "recorded" },
        "recommendation_id": { "$ref": "common.schema.json#/$defs/recommendationId" },
        "action": {
          "type": "string",
          "enum": ["rejected_all", "dismissed"]
        }
      },
      "additionalProperties": false
    },
    "rejectScheduleRecommendationErrorResult": {
      "oneOf": [
        { "$ref": "#/$defs/errorRecommendationNotFound" },
        { "$ref": "#/$defs/errorRecommendationExpired" },
        { "$ref": "#/$defs/errorSpecialistTimeout" },
        { "$ref": "#/$defs/errorContractInvalid" },
        { "$ref": "#/$defs/errorOperationNotAllowed" }
      ]
    },
    "rejectScheduleRecommendationResult": {
      "oneOf": [
        { "$ref": "#/$defs/rejectScheduleRecommendationSuccessResult" },
        { "$ref": "#/$defs/rejectScheduleRecommendationErrorResult" }
      ]
    }
  }
}
