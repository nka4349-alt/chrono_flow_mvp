{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-secretary-home.local/contracts/secretary_creation/v1/details.schema.json",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "event"
        },
        "title": {
          "type": "string",
          "maxLength": 200,
          "pattern": "^[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f]*$",
          "minLength": 1,
          "allOf": [
            {
              "pattern": "\\S"
            }
          ]
        },
        "description": {
          "type": "string",
          "maxLength": 4000,
          "pattern": "^[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f]*$"
        },
        "location": {
          "type": "string",
          "maxLength": 500,
          "pattern": "^[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f]*$"
        },
        "start_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,6})?(?:Z|[+-](?:[01]\\d|2[0-3]):[0-5]\\d)$"
        },
        "end_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,6})?(?:Z|[+-](?:[01]\\d|2[0-3]):[0-5]\\d)$"
        },
        "all_day": {
          "type": "boolean"
        },
        "time_zone": {
          "const": "Asia/Tokyo"
        }
      },
      "required": [
        "kind",
        "title",
        "description",
        "location",
        "start_at",
        "end_at",
        "all_day",
        "time_zone"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "task"
        },
        "title": {
          "type": "string",
          "maxLength": 200,
          "pattern": "^[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f]*$",
          "minLength": 1,
          "allOf": [
            {
              "pattern": "\\S"
            }
          ]
        },
        "description": {
          "type": "string",
          "maxLength": 4000,
          "pattern": "^[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f]*$"
        },
        "due_date": {
          "oneOf": [
            {
              "type": "string",
              "format": "date",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "due_time": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"
            },
            {
              "type": "null"
            }
          ]
        },
        "time_zone": {
          "const": "Asia/Tokyo"
        }
      },
      "required": [
        "kind",
        "title",
        "description",
        "due_date",
        "due_time",
        "time_zone"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "due_date": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "due_time": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  ]
}
