{
  "version": "draft-0.1",
  "providers": {
    "chrono_flow": {
      "operations": ["event.update", "event.delete"],
      "workspace_id": "forbidden",
      "audience": "chrono-flow-secretary-mutations",
      "refresh_capability": "schedule_context"
    },
    "chrono_task": {
      "operations": ["task.update", "task.delete", "task.complete", "task.postpone"],
      "workspace_id": "required canonical UUID",
      "audience": "chrono-task-secretary-mutations",
      "refresh_capability": "task_today_summary"
    }
  },
  "operations": {
    "event.update": { "provider": "chrono_flow", "snapshot_kind": "event", "changed_fields": ["description", "location", "schedule", "title"], "required_changed_fields": null, "after": "event snapshot", "planned_related_effects": "none" },
    "event.delete": { "provider": "chrono_flow", "snapshot_kind": "event", "changed_fields": ["$record"], "required_changed_fields": ["$record"], "after": null, "planned_related_effects": "event_delete" },
    "task.update": { "provider": "chrono_task", "snapshot_kind": "task", "changed_fields": ["deadline", "description", "priority", "title"], "required_changed_fields": null, "after": "task snapshot", "planned_related_effects": "none" },
    "task.delete": { "provider": "chrono_task", "snapshot_kind": "task", "changed_fields": ["$record"], "required_changed_fields": ["$record"], "after": null, "planned_related_effects": "task_delete" },
    "task.complete": { "provider": "chrono_task", "snapshot_kind": "task", "changed_fields": ["status"], "required_changed_fields": ["status"], "after": "task snapshot with status done", "planned_related_effects": "none" },
    "task.postpone": { "provider": "chrono_task", "snapshot_kind": "task", "changed_fields": ["deadline"], "required_changed_fields": ["deadline"], "after": "task snapshot with preserved deadline precision", "planned_related_effects": "none" }
  },
  "statuses": ["needs_target", "needs_clarification", "ready", "rejected", "completed", "completed_tombstone", "cancelled", "expired", "conflicted"],
  "rejected_reason_codes": ["already_completed", "no_effect", "unsupported_change", "ineligible_shared_event", "ineligible_recurring_event", "ineligible_relationships", "ineligible_other_assignee", "ineligible_notification_history", "reminder_consistency_requires_gate"],
  "terminal_reason_codes": ["user_cancelled", "execution_expired", "target_changed", "relationships_changed", "proposal_changed", "receipt_detail_expired"],
  "safe_error_codes": ["invalid_request", "unauthenticated", "forbidden", "not_found", "target_changed", "proposal_changed", "idempotency_conflict", "expired", "unsupported", "conflict", "in_progress", "unavailable", "outcome_unknown"],
  "retryable_error_codes": ["in_progress", "unavailable"],
  "limits": {
    "propose_body_bytes": 16384,
    "confirm_body_bytes": 8192,
    "cancel_body_bytes": 8192,
    "message_unicode_scalars_initial": 4000,
    "message_unicode_scalars_follow_up": 2000,
    "candidate_display": 5,
    "candidate_fetch": 6,
    "max_in_flight_per_home_session": 1,
    "max_unexecuted_proposals_per_home_session": 5,
    "execution_ttl_seconds_min": 120,
    "execution_ttl_seconds_max": 600,
    "jwt_ttl_seconds_max": 60,
    "jwt_clock_skew_seconds": 5,
    "replay_retention_seconds": 65,
    "receipt_detail_retention_seconds": 2592000,
    "status_retention_seconds": 34560000,
    "idempotency_retention_seconds": 34560000,
    "refresh_scope_seconds": 600
  },
  "search_window": { "start_days_from_provider_local_date_inclusive": -366, "end_days_from_provider_local_date_exclusive": 732, "calendar_days_not_fixed_seconds": true }
}
