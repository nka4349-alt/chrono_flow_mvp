{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-secretary-home.local/contracts/v2.1/specialist_response.schema.json",
  "title": "SpecialistResponse",
  "type": "object",
  "required": [
    "version",
    "response_id",
    "request_id",
    "call_id",
    "trace_id",
    "specialist",
    "status",
    "facts",
    "proposals",
    "warnings",
    "confidence",
    "generated_at"
  ],
  "properties": {
    "version": {
      "const": "2.1"
    },
    "response_id": {
      "type": "string"
    },
    "request_id": {
      "type": "string"
    },
    "call_id": {
      "type": "string"
    },
    "trace_id": {
      "type": "string"
    },
    "specialist": {
      "enum": [
        "chrono_flow_ai",
        "chrono_task_ai"
      ]
    },
    "status": {
      "enum": [
        "completed",
        "needs_clarification",
        "partial",
        "failed"
      ]
    },
    "summary": {
      "type": [
        "string",
        "null"
      ]
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "fact_type",
          "fields"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "fact_type": {
            "type": "string"
          },
          "fields": {
            "type": "object"
          },
          "source_updated_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        },
        "additionalProperties": false
      }
    },
    "proposals": {
      "type": "array",
      "items": {
        "$ref": "action_proposal.schema.json"
      }
    },
    "clarification": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "question",
            "missing_fields"
          ],
          "properties": {
            "question": {
              "type": "string"
            },
            "missing_fields": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "stale_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
